{
  "version": 3,
  "routes": [
    {
      "src": "^/(?:(.+)/)?index(?:\\.html)?/?$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/(.*)\\.html/?$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    }
  ],
  "overrides": {
    "asset_gallery.html": {
      "path": "asset_gallery"
    },
    "index.html": {
      "path": "index"
    },
    "thank-you.html": {
      "path": "thank-you"
    },
    "tmp/motion-backup/index.html": {
      "path": "tmp/motion-backup/index"
    },
    "tmp/pre-prototype-backup/asset_gallery.html": {
      "path": "tmp/pre-prototype-backup/asset_gallery"
    },
    "tmp/pre-prototype-backup/index.html": {
      "path": "tmp/pre-prototype-backup/index"
    },
    "tmp/tracking-route-backup/index.html": {
      "path": "tmp/tracking-route-backup/index"
    },
    "tracking/index.html": {
      "path": "tracking/index"
    }
  },
  "crons": []
}
